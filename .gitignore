# Workspace runtime directories (never committed)
/logs
/var
/tmp

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Filled-in backend launcher (machine specific, never commit)
/scripts/*_local.cmd

# Crate-local rules (build artifacts, cargo cache, out/, fixtures) live in
